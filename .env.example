# Copy to .env.local. No real value ever gets committed.
# On Netlify these are set in the site's env var UI.
#
# This site has no database and no secrets. If you find yourself adding a
# Supabase or Webflow variable here, you are on the wrong branch: that is
# invisible.garden, on `main`.

# Absolute origin of the deployed site, used for the sitemap, robots and
# OpenGraph URLs.
NEXT_PUBLIC_SITE_URL="https://invisiblecommons.org"

# --- Analytics: Umami, its own site id, kept apart from invisible.garden's ---
# Both must be set for the script to render, so previews stay out of the stats.
# Cloud: https://cloud.umami.is/script.js  Self-hosted: your own /script.js
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
