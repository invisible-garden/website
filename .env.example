# Copy to .env.local for the app, or .env for the migration scripts.
# No real value ever gets committed. See tech-design section 8.
# On Netlify the two NEXT_PUBLIC_ values are set in the site's env var UI.

# --- Public, shipped to the browser, read-only by RLS ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Absolute origin of the deployed site, used for sitemap, robots and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL="https://invisible.garden"

# --- Server side only, never NEXT_PUBLIC_, never committed ---
# Secret key, bypasses RLS. Migration script only.
SUPABASE_SECRET_KEY="sb_secret_..."

# Supabase Storage bucket holding people photos and partner logos. The site
# needs the NEXT_PUBLIC_ one because client components build image URLs; the
# migration scripts read the plain one.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="media"
SUPABASE_STORAGE_BUCKET="media"

# Supabase Management API token, used by the CLI to apply migrations and
# generate types. Local only.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF="jdlldzwwjjbnjqoebqjj"

# Database password, for `supabase link`, `db push` and psql. Local only.
SUPABASE_DB_PASSWORD=""

# Read-only Webflow Site API token. Migration only, revoke after cutover.
WEBFLOW_API_TOKEN=""
WEBFLOW_SITE_ID="6695a56b501ba1fda80ae466"

# --- Analytics, optional until chosen (Plausible or Umami) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=""
